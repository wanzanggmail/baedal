# OXPAY 배달 — 환경 변수 예시
# 서버에서 cp .env.example .env 후 값을 채우세요.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my_web_db
DB_USER=baedal_app
DB_PASS=ehRoql1!
DB_CHARSET=utf8mb4

# RDS 등 require_secure_transport=ON 인 DB에 SSL로 접속할 때만 채움(CA 번들 경로).
# 비워두면 기존처럼 평문 접속(레거시 서버 호환).
# RDS면: curl -o /etc/pki/rds/global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSL_CA=/etc/pki/rds/global-bundle.pem

# 정산 엑셀 파일 열기 암호 (선택)
# SETTLEMENT_EXCEL_PASSWORD=공통비밀번호
# SETTLEMENT_EXCEL_PASSWORD_BAEMIN=배민전용
# SETTLEMENT_PYTHON_BIN=/usr/bin/python3

# 저장 암호화 키 — php tools/gen_enc_key.php 로 생성해 넣으세요.
# 없으면 PG 결제키·계좌번호 저장이 거부됩니다. 서버마다 같은 값이어야 합니다.
APP_ENC_KEY=
